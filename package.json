{
  "name": "cypher-quiz",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "vp run db && vp -C packages/api run dev",
    "build-storybook": "vp -C packages/web run build-storybook",
    "db": "docker compose up --detach --wait neo4j && docker compose run --rm seed",
    "db:clean": "docker compose --profile test down --volumes --remove-orphans",
    "db:stop": "docker compose stop neo4j",
    "dev": "vp run db && vp run --parallel -F @cypher-quiz/api -F @cypher-quiz/web dev",
    "openapi:check": "vp -C packages/api run openapi:check",
    "openapi:write": "vp -C packages/api run openapi:write",
    "storybook": "vp -C packages/web run storybook",
    "test": "vp test run && vp run test:api",
    "test:api": "bash scripts/test-api.sh",
    "test:web": "vp -C packages/web run test",
    "typecheck": "vp run -F './packages/*' typecheck",
    "web": "vp -C packages/web dev"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2"
}
