# dev 専用の使い捨て。docker-compose.yml と api の自動接続が同じ値を読む
# （docs/03_api.md#資格情報の出どころを-1-箇所にする）
NEO4J_PASSWORD=nordwind-dev

# 自動接続。既定は無効
DEV_AUTO_CONNECT=true

# 繋ぎ先（NEO4J_URI / NEO4J_USER）はここに置かない。docker-compose.yml が渡す
# ——コンテナからは neo4j:7687、ホストからは localhost:7687 で名前が違う

# 既定ではローカル宛のみ許可。リモートに自動接続したいときだけ
# DEV_AUTO_CONNECT_ALLOW_REMOTE=true

# api のポート。web の dev proxy（packages/web/vite.config.ts）と揃える
PORT=8787

# ログの下限。debug にすると debug も出る（既定は info）
# LOG_LEVEL=debug
